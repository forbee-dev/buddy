{
  "name": "buddy-companion",
  "displayName": "Buddy Companion",
  "description": "Lets the Buddy macOS app type into and focus integrated terminals.",
  "version": "0.1.4",
  "publisher": "tiagosantos-local",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://github.com/forbee-dev/buddy/tree/main/vscode-ext#readme",
  "bugs": {
    "url": "https://github.com/forbee-dev/buddy/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/forbee-dev/buddy.git",
    "directory": "vscode-ext"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "cursor",
    "terminal",
    "mascot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "buddy.showLog",
        "title": "Buddy: Show Log"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test out/test/*.test.js",
    "package": "npm run build && vsce package",
    "publish:ovsx": "ovsx publish buddy-companion-$npm_package_version.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.0",
    "ovsx": "^1.3.0",
    "typescript": "^5.4.0"
  }
}
